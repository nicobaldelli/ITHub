# ============================================================
# ITHub API - config del web server para public/
# Front controller pattern + security hardening
#
# Escrito para funcionar tanto en Apache como en LiteSpeed (Hostinger):
# sin <If>/ap_expr ni condiciones "expr=" que LiteSpeed no interpreta.
# ============================================================

# Asegurar HTTPS (Hostinger ya lo fuerza pero defensa en profundidad)
# Se omite la redirección en localhost para permitir desarrollo local sin TLS.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP_HOST} !^localhost(:[0-9]+)?$ [NC]
    RewriteCond %{HTTP_HOST} !^127\. [NC]
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Pasar Authorization header (algunos hosts lo descartan antes de llegar a PHP).
    # Va ANTES del front controller para que se evalúe en la primera pasada.
    RewriteCond %{HTTP:Authorization} ^(.*)
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%1]

    # Front controller: cualquier ruta que no sea un archivo/directorio real → index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# Ocultar archivos sensibles si llegaran a copiarse a public/ por error
<FilesMatch "(^\.|\.env|\.git|\.htaccess|composer\.|phinx\.|\.md$|\.log$)">
    Require all denied
</FilesMatch>

# No servir archivos PHP fuera del front controller.
# (Dos bloques en vez de <If>: el segundo, más específico, gana.)
<FilesMatch "\.ph(p[0-9]?|tml|ar)$">
    Require all denied
</FilesMatch>
<Files "index.php">
    Require all granted
</Files>

# Deshabilitar listado de directorios.
# +FollowSymLinks hace falta para el symlink public_html -> app/api/public.
# Si el host da 500 por no permitir "Options" en .htaccess, borrar esta línea.
Options -Indexes -MultiViews +FollowSymLinks

# Cabeceras de seguridad (SecurityHeadersMiddleware las pone también desde PHP,
# incluida HSTS; acá quedan como defensa en profundidad para respuestas que no
# lleguen a PHP).
<IfModule mod_headers.c>
    Header unset X-Powered-By
    Header always unset X-Powered-By

    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=()"
    Header always set X-Permitted-Cross-Domain-Policies "none"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Cross-Origin-Resource-Policy "same-site"
</IfModule>

# Comprimir respuestas
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE application/json application/javascript text/css text/plain text/html
</IfModule>

# Charset por defecto
AddDefaultCharset UTF-8
