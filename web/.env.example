# ============================================================
# ITHub Web — variables de entorno
# Copiá a .env.local y ajustá si corresponde.
# ============================================================
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Login con Google (ver docs/google-login-setup.md). Mismo client id que
# GOOGLE_OAUTH_CLIENT_ID en la API. Vacio = el boton no se muestra.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_HOSTED_DOMAIN=intellihelp.tech
